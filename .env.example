# ==============================================================================
# NutriAgent Environment Configuration
# ==============================================================================
# Note: The application operates completely out-of-the-box in Demo/Guest mode
# without any paid or external services. Configure these keys to enable cloud sync
# and advanced multimodal Gemini Vision.
# ==============================================================================

# Google Gemini API (Optional: used for Gemini 1.5 Flash Vision OCR & Natural Language Explanations)
# Obtain at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=gemini-api-key-here
# Supabase (Optional: used for cloud PostgreSQL database & persistent multi-device auth)
# Obtain at: https://supabase.com/dashboard
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# App Canonical URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

